<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Discuss assistant's bot: a contact with no user (no login, no seat).
         A direct message to it, or a mention of it in a channel, is a question. -->
    <data noupdate="1">
        <record id="partner_styd_bot" model="res.partner">
            <field name="name">Speak To Your Database</field>
            <field name="image_1920" type="bytes" file="styd_odoo_bridge/static/description/icon.png"/>
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- The Discuss job: sends pending questions out over the outbound channel,
         posts the answers that arrived, closes questions with no answer in time.
         A new question or answer triggers it at once; the minute is a fallback. -->
    <record id="ir_cron_styd_discuss" model="ir.cron">
        <field name="name">Speak To Your Database: Discuss assistant</field>
        <field name="model_id" ref="model_styd_discuss_question"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
